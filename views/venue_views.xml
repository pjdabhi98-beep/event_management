<odoo>
    <!-- Venue List View -->
    <record id="view_event_venue_list" model="ir.ui.view">
        <field name="name">event.venue.list</field>
        <field name="model">event.venue</field>
        <field name="arch" type="xml">
            <list string="Venues">
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <!-- Venue Form View -->
    <record id="view_event_venue_form" model="ir.ui.view">
        <field name="name">event.venue.form</field>
        <field name="model">event.venue</field>
        <field name="arch" type="xml">
            <form string="Venue">
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Venue Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="location"/>
                            <field name="capacity"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Events">
                            <field name="event_ids">
                                <list>
                                    <field name="event_id"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Venue Action -->
    <record id="action_event_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">event.venue</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Venue Menu -->
    <menuitem id="menu_event_venue"
              name="Venues"
              parent="menu_event_management_root"
              action="action_event_venue"
              sequence="20"/>
</odoo>
