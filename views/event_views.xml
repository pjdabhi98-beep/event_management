<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Event List View -->
    <record id="view_event_event_list" model="ir.ui.view">
        <field name="name">event.event.list</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <list string="Events">
                <field name="event_id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="location"/>
                <field name="venue_id"/>
                <field name="capacity"/>
                <field name="registered_count" readonly="1"/>
                <field name="available_seats" readonly="1"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Event Form View -->
    <record id="view_event_event_form" model="ir.ui.view">
        <field name="name">event.event.form</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <form string="Event">

                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_start"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'confirmed'"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'ongoing'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="status in ('completed', 'cancelled')"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="status not in ('cancelled', 'completed')"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,ongoing,completed"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Event Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="date"/>
                            <field name="venue_id"/>
                        </group>

                        <group>
                            <field name="location"/>
                            <field name="capacity"/>
                            <field name="registered_count" readonly="1"/>
                            <field name="available_seats" readonly="1"/>
                        </group>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Event Action -->
    <record id="action_event_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_event_management_root"
              name="Event Management"
              sequence="10"/>

    <!-- Event Menu -->
    <menuitem id="menu_event_event"
              name="Events"
              parent="menu_event_management_root"
              action="action_event_event"
              sequence="10"/>

</odoo>
